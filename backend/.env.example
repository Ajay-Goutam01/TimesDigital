# ========================================================
# TIME PUBLIC SCHOOL & TIMES DIGITAL — Backend Environment
# Copy this file to .env and fill in your actual values.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Local dev example: http://localhost:5173
# Production example: https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# MongoDB Connection (use MongoDB Atlas URI for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/times_digital_db?retryWrites=true&w=majority

# Authentication / JWT
JWT_SECRET=generate_a_64_char_random_hex_string_here
JWT_EXPIRES_IN=7d

# Cookie signing secret (used by cookie-parser)
COOKIE_SECRET=generate_a_secure_random_string_here

# ImageKit Storage
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
